{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run",
			"type": "shell",
			"command": "${workspaceFolder}/bin/Mu.windows.editor.dev.x86_64.exe",
			"args": [
				"--path",
				"${workspaceFolder}/Project/cpp-model"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "build",
			"group": "build",
			"type": "shell",
			"command": "scons",
			"args": [
				// enable for debugging with breakpoints
				"dev_build=yes",
			],
			"problemMatcher": "$msCompile"
		}
	]
}